# Chat Circles 生产反代：ICP备案完成后使用标准 80/443。
# Caddy 自动申请/续期 HTTPS 证书，并把外部流量转发到 Docker 私网中的 app:8090。
# 不再使用未备案时期的 :8443 + 阿里云 DNS-01 临时方案，也不需要 DNS AccessKey。
#
# 生产环境封闭 PocketBase 管理台（/_/ 路径）：日常运营不需要 PB dashboard
# （统一走产品内 /super 后台），封闭可减少暴露面；临时排障时注释下方
# handle /_/* 段并 docker compose restart caddy 即可恢复，用完立即还原。

chatcircle.empact.cn {
	# 不显式配置 tls/dns：Caddy 使用标准 Automatic HTTPS，
	# 通过可达的 80/443 完成证书签发/续期，并自动把 HTTP 重定向到 HTTPS。

	# 安全响应头。style-src 'unsafe-inline' 为 React 内联样式所需；
	# CSP frame-ancestors 'none' 与 X-Frame-Options 并存，兼容不支持前者的旧浏览器
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	# 封闭 PB 管理台（见文件头注释）
	handle /_/* {
		respond 403
	}

	handle {
		reverse_proxy app:8090 {
			# 覆盖（而非追加）客户端伪造的 X-Forwarded-For，
			# 保证后端日志/审计与后续按 IP 限流拿到的是真实来源
			header_up X-Forwarded-For {remote_host}
		}
	}
}
