# Chat Circles 生产反代：全站 HTTPS，转发到 PocketBase 一体化应用（app:8090）。
# 未备案期间站点挂在 8443（境内 ECS 80/443 被拦截）；备案后把站点地址改为
# chatcircle.empact.cn 并去掉端口、compose 端口映射改为 443:443 即可。
#
# 生产环境封闭 PocketBase 管理台（/_/ 路径）：日常运营不需要 PB dashboard
# （统一走产品内 /super 后台），封闭可减少暴露面；临时排障时注释下方
# handle /_/* 段并 docker compose restart caddy 即可恢复，用完立即还原。

chatcircle.empact.cn:8443 {
	# DNS-01 挑战（阿里云 DNS），凭据经环境变量注入（.env，不入库）
	tls {
		dns alidns {
			access_key_id {$ALIYUN_ACCESS_KEY_ID}
			access_key_secret {$ALIYUN_ACCESS_KEY_SECRET}
		}
	}

	# 安全响应头。style-src 'unsafe-inline' 为 React 内联样式所需；
	# CSP frame-ancestors 'none' 与 X-Frame-Options 并存，兼容不支持前者的旧浏览器
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	# 封闭 PB 管理台（见文件头注释）
	handle /_/* {
		respond 403
	}

	handle {
		reverse_proxy app:8090 {
			# 覆盖（而非追加）客户端伪造的 X-Forwarded-For，
			# 保证后端日志/审计与后续按 IP 限流拿到的是真实来源
			header_up X-Forwarded-For {remote_host}
		}
	}
}
