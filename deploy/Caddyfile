# Chat Circles 生产反代：全站 HTTPS，转发到 PocketBase 一体化应用（app:8090）。
# 未备案期间站点挂在 8443（境内 ECS 80/443 被拦截）；备案后把站点地址改为
# chatcircle.empact.cn 并去掉端口、compose 端口映射改为 443:443 即可。

chatcircle.empact.cn:8443 {
	# DNS-01 挑战（阿里云 DNS），凭据经环境变量注入（.env，不入库）
	tls {
		dns alidns {
			access_key_id {$ALIYUN_ACCESS_KEY_ID}
			access_key_secret {$ALIYUN_ACCESS_KEY_SECRET}
		}
	}

	reverse_proxy app:8090
}
