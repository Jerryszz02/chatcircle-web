# Chat Circles 环境变量示例 —— 复制为 .env 后按环境填写；真实 .env 与 secrets 一律不入库（technical-design §5.7）

# PocketBase 版本（CI / Dockerfile / 本地下载保持一致；锁定记录见 technical-design 待确认 #11）
PB_VERSION=0.28.4

# 前端访问后端的地址（Vite 构建变量）。生产为同源部署，通常留空；本地开发默认 http://127.0.0.1:8090
VITE_PB_URL=

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 参与者手机号认证（T1）。生产必须使用 aliyun；mock 只允许本地/测试环境。
CC_ENVIRONMENT=production
CC_SMS_PROVIDER=aliyun
# 至少 32 字符、独立生成的部署密钥；用于手机号 HMAC 查找，轮换前须制定数据迁移方案。
# CC_PHONE_HASH_KEY=
# 阿里云号码认证服务（Dypnsapi）专用 RAM 凭据。
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 使用临时凭据时填写：
# ALIBABA_CLOUD_SECURITY_TOKEN=
# 短信认证控制台配置；签名/模板不得硬编码进 hook。
# 生产（CC_SMS_PROVIDER=aliyun）必须按业务场景分别配置三个模板 CODE：
#   登录/注册 → CC_SMS_TEMPLATE_LOGIN_REGISTER_CODE（阿里云赠送模板 100001）
#   首次绑定新手机号 / 换绑新号 → CC_SMS_TEMPLATE_BIND_NEW_CODE（100004）
#   换绑时验证当前旧手机号 → CC_SMS_TEMPLATE_VERIFY_BOUND_CODE（100005）
# CC_SMS_SIGN_NAME=
# CC_SMS_TEMPLATE_LOGIN_REGISTER_CODE=
# CC_SMS_TEMPLATE_BIND_NEW_CODE=
# CC_SMS_TEMPLATE_VERIFY_BOUND_CODE=
# 迁移期兼容变量：新后端代码不再读取它，也不作为生产预检依据，真机验收后可移除。
# CC_SMS_TEMPLATE_CODE=
# CC_SMS_SCHEME_NAME=
# CC_PARTICIPANT_PRIVACY_NOTICE_VERSION=2026-08-28.v1

# —— 以下为部署期注入的 secrets 占位，禁止在仓库中填写真实值 ——
# 超级管理员初始凭据（初始部署时以 pocketbase superuser create 创建，流程待确认）
# PB_SUPERUSER_EMAIL=
# PB_SUPERUSER_PASSWORD=
# 数据分析 agent 的超管服务账号凭据（供 mcp/ MCP server 以 env 注入；与 human 超管分开、可独立吊销，
# 见 mcp/README.md 与 docs/planning/security-privacy.md §11 的服务账号例外说明）
# CC_AGENT_EMAIL=
# CC_AGENT_PASSWORD=

# HTTPS 由 Caddy Automatic HTTPS 通过标准 80/443 自动申请/续期证书。
# ICP 备案完成后的正式部署不再使用 :8443 + 阿里云 DNS-01，因此无需 ALIYUN_ACCESS_KEY_*。
